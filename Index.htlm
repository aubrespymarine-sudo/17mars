<title>17mars</title>
<style>
*{box-sizing:border-box}
body{
  margin:0;
  min-height:100vh;
  background:#faf9f7;
  color:#292724;
  font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
  display:flex;
  justify-content:center;
  padding:34px 18px
}
main{width:100%;max-width:430px;text-align:center}
.heart{font-size:25px;margin:4px 0 30px}
nav{display:grid;gap:11px}
a{
  display:block;
  text-decoration:none;
  color:#292724;
  background:#fff;
  border:1px solid #e4e1db;
  border-radius:12px;
  padding:16px 18px;
  font-size:15px
}
</style>
</head>
<body>
<main>
<div class="heart">♡</div>
<nav>
